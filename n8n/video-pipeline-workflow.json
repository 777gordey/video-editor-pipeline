      "parameters": {
        "jsCode": "const started = new Date($('Build video_url').first().json.dispatch_ts).getTime();\nconst elapsedMin = (Date.now() - started) / 60000;\nreturn [{ json: { elapsedMin, timedOut: elapsedMin > 10 } }];"
      },
