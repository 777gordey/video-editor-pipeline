      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "credentials": {
        "githubApi": {
          "id": "__GITHUB_CRED_ID__",
          "name": "GitHub Token (repo scope)"
        }
      }
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$json.headers.location}}",
        "authentication": "none",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          },
          "timeout": 900000
        }
      },
      "id": "fd2b8c42-59a4-4ad1-8b6b-1b49ae86bd77",
      "name": "Download artifact zip",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "operation": "decompress",
        "fileName": "data"
      },
      "id": "f75ffb46-e47c-4dd8-947a-7fc41d075f01",
      "name": "Unzip",
      "type": "n8n-nodes-base.compression",
      "typeVersion": 1.1,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const args = $('When called').first().json;\nconst item = $input.first();\nconst byName = {};\nfor (const b of Object.values(item.binary || {})) byName[b.fileName] = b;\nconst NAMES = {V1:'V1 Bold Yellow',V2:'V2 Neon ADHD',V3:'V3 Editorial',V4:'V4 Chrome 3D',V5:'V5 Soft Pastel'};\nconst out = [];\nif (args.mode === 'docs') {\n  for (const v of ['V1','V2','V3','V4','V5']) {\n    if (byName['cover_' + v + '.jpg']) out.push({ json: { kind: 'photo', caption: NAMES[v] + ' — обложка' }, binary: { data: byName['cover_' + v + '.jpg'] } });\n  }\n  for (const [fn, cap] of [['cuts.md', 'cuts.md — что вырезано и ускорено'], ['QA_report.md', 'QA_report.md — автопроверка всех версий']]) {\n    if (byName[fn]) out.push({ json: { kind: 'doc', caption: cap }, binary: { data: byName[fn] } });\n  }\n} else {\n  const v = args.version;\n  const video = byName['final_' + v + '.mp4'];\n  if (!video) throw new Error('final_' + v + '.mp4 not found in artifact; got: ' + Object.keys(byName).join(', '));\n  out.push({ json: { kind: 'video', caption: NAMES[v] }, binary: { data: video } });\n}\nif (!out.length) throw new Error('nothing to send for ' + JSON.stringify(args));\nreturn out;"
      },
      "id": "c3c926f5-862c-4621-9005-f2876927f38c",
      "name": "Pick files by name",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
