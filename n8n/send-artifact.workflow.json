{
  "name": "Video pipeline: send one artifact (v2 helper)",
  "nodes": [
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "cf09db29-a784-4efe-8ea0-4f811451d014",
      "name": "When called",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{$env.GITHUB_OWNER}}/{{$env.GITHUB_REPO}}/actions/artifacts/{{$json.artifact_id}}/zip",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "options": {
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "id": "6e62377f-1b39-419d-8bd7-e691f1e880d4",
      "name": "Get artifact download URL",
