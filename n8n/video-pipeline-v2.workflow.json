    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const item = $input.first();\nconst byName = {};\nfor (const b of Object.values(item.binary || {})) byName[b.fileName] = b;\nconst video = byName['final.mp4'];\nif (!video) throw new Error('final.mp4 not found in artifact; got: ' + Object.keys(byName).join(', '));\nconst binary = { video };\nif (byName['thumbnail_1080x1920.jpg']) binary.cover = byName['thumbnail_1080x1920.jpg'];\nreturn [{ json: { hasCover: !!binary.cover }, binary }];\n"
      },
