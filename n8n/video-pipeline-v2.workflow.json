    {
      "parameters": {
        "jsCode": "const dispatchTs = new Date($('Build video_url').first().json.dispatch_ts).getTime();\nconst runs = $input.first().json.workflow_runs || [];\nconst match = runs.find(r => new Date(r.created_at).getTime() >= dispatchTs - 5000);\nif (!match) {\n  return [{ json: { found: false, dispatch_ts: $('Build video_url').first().json.dispatch_ts } }];\n}\nreturn [{ json: { found: true, run_id: match.id, status: match.status, conclusion: match.conclusion, html_url: match.html_url, dispatch_ts: $('Build video_url').first().json.dispatch_ts } }];"
      },
      "id": "code-pick-run",
      "name": "Pick matching run",
      "type": "n8n-nodes-base.code",
