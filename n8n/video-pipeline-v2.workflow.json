    {
      "parameters": {
        "jsCode": "const run = $('Pick matching run').first().json;\nconst arts = ($input.first().json.artifacts || []).filter(a => !a.expired);\nconst byName = {};\nfor (const a of arts) byName[a.name] = a.id;\nconst chat = $('Build video_url').first().json.chat_id;\nconst out = [], missing = [];\nfor (const v of ['V1', 'V2', 'V3', 'V4', 'V5']) {\n  if (byName['version-' + v]) out.push({ json: { artifact_id: byName['version-' + v], mode: 'version', version: v, chat_id: chat } });\n  else missing.push(v);\n}\nif (byName['docs']) out.push({ json: { artifact_id: byName['docs'], mode: 'docs', version: '', chat_id: chat } });\nif (!out.length) throw new Error('no artifacts in run ' + run.html_url);\nout[0].json.missing = missing;\nout[0].json.run_url = run.html_url;\nreturn out;"
      },
